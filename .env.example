OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODELS=anthropic/claude-sonnet-5-5,openai/gpt-4o-mini
LLM_TIMEOUT=30
LLM_RETRIES=2
LLM_MAX_TOKENS=16000
APP_ENV=development
LOG_LEVEL=INFO

# Input moderation (OpenAI moderation via LiteLLM; needs OPENAI_API_KEY; fails open)
MODERATION_ENABLED=false
# Exact response cache (Redis)
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
# Semantic cache (redisvl; needs Redis Stack; LOG_ONLY logs would-be hits without serving them)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_LOG_ONLY=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

SESSION_MAX_TURNS=10