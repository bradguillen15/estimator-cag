OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODELS=anthropic/claude-sonnet-5-5,openai/gpt-4o-mini
LLM_TIMEOUT=30
LLM_RETRIES=2
LLM_MAX_TOKENS=16000
APP_ENV=development
LOG_LEVEL=INFO

# Input moderation (OpenAI moderation via LiteLLM; needs OPENAI_API_KEY; fails open)
MODERATION_ENABLED=false
# Exact response cache (Redis)
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
# Semantic cache (redisvl; needs Redis Stack; LOG_ONLY logs would-be hits without serving them)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_LOG_ONLY=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

SESSION_MAX_TURNS=10

# Session history compression
# Max turns kept verbatim after leaving the window (commitments like an NDA or a frozen budget). 0 disables.
SESSION_MAX_ANCHORS=5
# Hard cap (chars) on the running summary of turns folded out of the window. Min 200.
SESSION_SUMMARY_MAX_CHARS=2000

# Critic review loop (/estimate/reviewed, /sessions/{id}/estimate/reviewed)
# Critic model as <provider>/<model>. Empty = reuse the main LLM_MODELS chain.
CRITIC_MODEL=
# Max actor attempts per reviewed estimate (each attempt = 1 actor + 1 critic call). Min 1.
REVIEW_MAX_ITERATIONS=3

DATABASE_URL=postgresql+psycopg://estimator:estimator@localhost:5433/estimator
CATALOG_PATH=data/catalog/catalog.yaml
INGESTION_DATA_ROOT=data/seed
PRESIDIO_SPACY_MODEL=es_core_news_md
PSEUDONYM_FAKER_LOCALE=es_ES
PSEUDONYM_HASH_SALT=change-me-in-prod