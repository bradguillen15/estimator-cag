  "cards": [
    {
      "dot": "amber",
      "title": "Stateless request",
      "items": [
        "Guardrails run before the handler, so a rejection is a 400, never an SSE error",
        "The audience tier is resolved first and joins both cache keys, so tiers never share an answer",
        "A cache hit skips the prompt and the LLM",
        "Only answers that pass the output check are cached"
      ]
    },
    {
      "dot": "violet",
      "title": "Session turn",
      "items": [
        "The UI sends every turn through a session; attachments become text before the guardrails",
        "No cache: the prompt also carries the history window and the project facts",
        "After the answer, the turn is recorded, overflowing turns are compressed, and a second LLM call refreshes the facts"
      ]
    },
    {
      "dot": "rose",
      "title": "Critic review loop",
      "items": [
        "POST /estimate/reviewed and /sessions/{id}/estimate/reviewed: the Actor drafts, the Critic (CRITIC_MODEL or the main chain) audits, the ReviewLoop re-calls the Actor with the issues",
        "Stops on accept or reject, or after REVIEW_MAX_ITERATIONS attempts; both caches are bypassed",
        "A failed review accepts the draft instead of failing the request"
      ]
    },
    {
      "dot": "orange",
      "title": "History compression",
      "items": [
        "Turns that leave the window are kept verbatim as anchors (NDA, frozen budget, deadline...) or folded into a running summary",
        "A failed summary keeps the previous one; anchors and summary render as a trailing prompt block"
      ]
    },
    {
      "dot": "cyan",
      "title": "CAG prompt",
      "items": [
        "Static rules + few-shot examples first, so the provider can cache them",
        "Every variable part is a trailing block: response language, audience tier, project facts, history memory, critic feedback"
      ]
    },
    {
      "dot": "emerald",
      "title": "Opt-in features",
      "items": [
        "Exact and semantic cache need Redis (CACHE_ENABLED, SEMANTIC_CACHE_ENABLED)",
        "Semantic cache and moderation call OpenAI through LiteLLM",
        "Sessions live in one process: a restart loses them"
      ]
    }
  ]
}