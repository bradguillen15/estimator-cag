  "cards": [
    {
      "dot": "rose",
      "title": "Where the transcript path ends",
      "items": [
        "/search returns SearchHit[] (chunks + distances) and stops.",
        "Nothing groups hits by budget, builds a prompt or produces hours.",
        "A real transcript does not even enter: SearchRequest.query is capped at 2000 chars (422)."
      ]
    },
    {
      "dot": "slate",
      "title": "Two halves, not connected",
      "items": [
        "CAG: EstimationService uses fixed examples from prompts/estimation/v3/examples.j2.",
        "RAG: embedding_pipeline and storage serve /search and feed nothing.",
        "ingest/ and /embeddings/ingest are also separate: the corpus is loaded from normalized JSON."
      ]
    }
