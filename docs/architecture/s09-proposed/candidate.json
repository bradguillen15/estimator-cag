  "cards": [
    {
      "dot": "orange",
      "title": "How to read it",
      "items": [
        "Modules tagged NEW inside a NEW (proposal) group do not exist in the repo yet, so they cite no source files.",
        "REUSED nodes cite the code that exists today; LiteLLM is UNCHANGED."
      ]
    },
    {
      "dot": "emerald",
      "title": "Failures each new module addresses",
      "items": [
        "RequirementExtractor: one query per need, not one per meeting (failures 1, 2).",
        "QueryPlanner + RelevanceFilter: short English queries and a relevance threshold (1, 3).",
        "AnalogAggregator: grouped by budget with diversity and data quality (4).",
        "ContextBuilder + TranscriptEstimationFlow: retrieval finally feeds generation (5).",
        "CoverageChecker: requirements without analogs become explicit gaps."
      ]
    }
  ]
